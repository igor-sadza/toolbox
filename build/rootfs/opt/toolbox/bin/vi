#!/usr/bin/env bash

############################################################
# Copyright (c) 2026 Igor Sadza
# Released under the GPLv3 license
# ----------------------------------------------------------
#
# FILE: ./build/rootfs/opt/toolbox/bin/vi
# DESC: Neovim wrapper - use toolbox-wide XDG paths
#
############################################################

set -Eeuo pipefail

exec env \
    XDG_CONFIG_HOME="${TOOLBOX_CONFIG}" \
    XDG_DATA_HOME="${TOOLBOX_DATA}" \
    XDG_STATE_HOME="${HOME}/.local/state" \
    XDG_CACHE_HOME="${TOOLBOX_CACHE}" \
    /usr/local/bin/vi "$@"

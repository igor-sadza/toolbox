############################################################
# Copyright (c) 2026 Igor Sadza
# Released under the GPLv3 license
# ----------------------------------------------------------
#
# FILE: ./.env.example
# DESC: Build arguments & runtime settings (copy to .env)
#
# ----------------------------------------------------------
# : Selected versions are pinned. Renovate bumps the values below
# : using the '# renovate:' markers (see renovate.json).
# : BIN checksums (*_SHA256) are refreshed automatically on
# : Renovate PRs by .github/workflows/checksums.yml
# : (or locally: .cicd/github/update-checksums.sh).
#
############################################################

# =======================
# Runtime (image)
# -----------------------
# : make start  -> pulls ${TOOLBOX_IMAGE}:${TOOLBOX_VERSION}
# : tags: latest | X.Y.Z | X.Y | X | weekly | edge
# : pin a version (e.g. 1.8.3) to stay put; roll back by
# : setting an older one and running 'make start' again
# =======================

TOOLBOX_IMAGE=ghcr.io/igor-sadza/toolbox
TOOLBOX_VERSION=latest

# =======================
# Base
# =======================

DISTRIBUTION=debian
SUITE=trixie-slim
DIGEST=sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd

# =======================
# Neovim (BIN)
# =======================

INSTALL_NEOVIM=true
# renovate: datasource=github-releases depName=neovim/neovim
NEOVIM_VERSION=v0.12.4
NEOVIM_SHA256=012bf3fcac5ade43914df3f174668bf64d05e049a4f032a388c027b1ebd78628

# =======================
# Docker (GPG)
# -----------------------
# : apt search containerd.io
# : apt search docker-buildx-plugin
# : apt search docker-ce
# : apt search docker-ce-cli
# : apt search docker-compose-plugin
# =======================

INSTALL_DOCKER=true
# renovate: datasource=deb depName=docker-ce registryUrl=https://download.docker.com/linux/debian?suite=trixie&components=stable&binaryArch=amd64
DOCKER_CE_VERSION="5:29.6.2-1~debian.13~trixie"
# renovate: datasource=deb depName=docker-ce-cli registryUrl=https://download.docker.com/linux/debian?suite=trixie&components=stable&binaryArch=amd64
DOCKER_CE_CLI_VERSION="5:29.6.2-1~debian.13~trixie"
# renovate: datasource=deb depName=containerd.io registryUrl=https://download.docker.com/linux/debian?suite=trixie&components=stable&binaryArch=amd64
CONTAINERD_VERSION="2.2.6-1~debian.13~trixie"
# renovate: datasource=deb depName=docker-buildx-plugin registryUrl=https://download.docker.com/linux/debian?suite=trixie&components=stable&binaryArch=amd64
DOCKER_BUILDX_VERSION="0.35.0-1~debian.13~trixie"
# renovate: datasource=deb depName=docker-compose-plugin registryUrl=https://download.docker.com/linux/debian?suite=trixie&components=stable&binaryArch=amd64
DOCKER_COMPOSE_VERSION="5.3.1-1~debian.13~trixie"

# =======================
# K9S (BIN)
# =======================

INSTALL_K9S=true
# renovate: datasource=github-releases depName=derailed/k9s
K9S_VERSION=v0.51.0
K9S_SHA256=c3752ad51a5a4015a113819c4eeb6e55a4d0e4b8e652494797532f6fc8161dd7

# =======================
# Helm (GPG)
# -----------------------
# : apt search helm$
# =======================

INSTALL_HELM=true
# renovate: datasource=deb depName=helm registryUrl=https://packages.buildkite.com/helm-linux/helm-debian/any?suite=any&components=main&binaryArch=amd64
HELM_VERSION=4.2.3-1

# =======================
# Kubectl (GPG)
# -----------------------
# : apt search kubectl$
# : pkgs.k8s.io is a flat repo (one per minor), so Renovate
# : tracks the upstream release; the '-1.1' suffix is kept.
# =======================

INSTALL_KUBECTL=true
# renovate: datasource=github-releases depName=kubernetes/kubernetes extractVersion=^v(?<version>.+)$
KUBECTL_VERSION=1.36.3-1.1

# =======================
# Terraform (GPG)
# -----------------------
# : apt search terraform$
# =======================

INSTALL_TERRAFORM=true
# renovate: datasource=deb depName=terraform registryUrl=https://apt.releases.hashicorp.com?suite=trixie&components=main&binaryArch=amd64
TERRAFORM_VERSION=1.15.8-1

# =======================
# AzureCLI (GPG)
# -----------------------
# : apt search azure-cli$
# =======================

INSTALL_AZURE_CLI=true
AZURE_CLI_SUITE=bookworm
# renovate: datasource=deb depName=azure-cli registryUrl=https://packages.microsoft.com/repos/azure-cli?suite=bookworm&components=main&binaryArch=amd64
AZURE_CLI_VERSION=2.88.0-1~bookworm

# =======================
# Node.js (GPG)
# -----------------------
# : apt search nodejs$
# : major upgrades = change NODE_JS_MAJOR (manual)
# =======================

INSTALL_NODE_JS=true
# renovate: datasource=deb depName=nodejs registryUrl=https://deb.nodesource.com/node_22.x?suite=nodistro&components=main&binaryArch=amd64
NODE_JS_VERSION=22.23.1-1nodesource1
NODE_JS_MAJOR=22

# =======================
# Gomplate (BIN)
# =======================

INSTALL_GOMPLATE=true
# renovate: datasource=github-releases depName=hairyhenderson/gomplate
GOMPLATE_VERSION=v5.2.0
GOMPLATE_SHA256=a235564c12f12e755c06e3ab2af414ab1e3f5b1f142eb82ea2d8086145670a81

# =======================
# ACT (BIN)
# =======================

INSTALL_ACT=true
# renovate: datasource=github-releases depName=nektos/act
ACT_VERSION=v0.2.89
ACT_SHA256=0191d6f1f3b716b5c55820032605d05fc3c1cdbf581ebeff655019e5dd1524c0

# =======================
# TMUX 
# =======================

# renovate: datasource=github-tags depName=tmux-plugins/tpm
TPM_REF=v3.1.0

# =======================
# Extras (packages)
# -----------------------
# : rust toolchain
# : cargo packages
# : node packages
# : python packages
# =======================

# renovate: datasource=github-releases depName=rust-lang/rust
RUST_TOOLCHAIN=1.98.1
# renovate: datasource=crate depName=tree-sitter-cli
CARGO_TREE_SITTER_CLI=0.26.11
# renovate: datasource=npm depName=neovim
NPM_NEOVIM=5.4.0
# renovate: datasource=npm depName=opencode-ai
NPM_OPENCODE_AI=1.18.13
# renovate: datasource=npm depName=@openai/codex
NPM_CODEX=0.153.4
# renovate: datasource=pypi depName=uv
PIPX_UV=0.12.1

# =======================
# Extras (configs)
# =======================

LIQUIDPROMPT_THEME=powerline

# =======================
# Planned tools
# -----------------------
# : see docs/roadmap.md
# : new tools follow the same section formula as above
# =======================

# INSTALL_AWS_CLI=false          # TODO: Cloud      (BIN)
# INSTALL_HADOLINT=false         # TODO: Lint       (BIN)
# INSTALL_SHELLCHECK=false       # TODO: Lint       (APT)
# INSTALL_ACTIONLINT=false       # TODO: Lint       (BIN)
# INSTALL_TRIVY=false            # TODO: Security   (GPG)
# INSTALL_GH=false               # TODO: Git        (GPG)
# INSTALL_KUBECTX=false          # TODO: Kubernetes (BIN)

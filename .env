# =======================
# Base 
# =======================

DISTRIBUTION=debian
SUITE=trixie-slim
DIGEST=sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd

# =======================
# -- Neovim (BIN)
# =======================

INSTALL_NEOVIM=true
NEOVIM_VERSION=v0.12.4
NEOVIM_SHA256=012bf3fcac5ade43914df3f174668bf64d05e049a4f032a388c027b1ebd78628

# =======================
# Docker (GPG)
# -----------------------
# : apt search containerd.io
# : apt search docker-buildx-plugin
# : apt search docker-ce
# : apt search docker-ce-cli
# : apt search docker-compose-plugin
# =======================

INSTALL_DOCKER=true
DOCKER_CE_VERSION="5:29.6.2-1~debian.13~trixie"
DOCKER_CE_CLI_VERSION="5:29.6.2-1~debian.13~trixie"
CONTAINERD_VERSION="2.2.6-1~debian.13~trixie"
DOCKER_BUILDX_VERSION="0.35.0-1~debian.13~trixie"
DOCKER_COMPOSE_VERSION="5.3.1-1~debian.13~trixie"

# =======================
# K9S (BIN)
# =======================

INSTALL_K9S=true
K9S_VERSION=v0.51.0
K9S_SHA256=c3752ad51a5a4015a113819c4eeb6e55a4d0e4b8e652494797532f6fc8161dd7

# =======================
# Helm (GPG)
# -----------------------
# : apt search helm$
# =======================

INSTALL_HELM=true
HELM_VERSION=4.2.3-1

# =======================
# Kubectl (GPG)
# -----------------------
# : apt search kubectl$
# =======================

INSTALL_KUBECTL=true
KUBECTL_VERSION=1.36.3-1.1

# =======================
# Terraform (GPG)
# -----------------------
# : apt search terraform$
# =======================

INSTALL_TERRAFORM=true
TERRAFORM_VERSION=1.15.8-1

# =======================
# AzureCLI (GPG)
# -----------------------
# : apt search azure-cli$
# =======================

INSTALL_AZURE_CLI=true
AZURE_CLI_SUITE=bookworm
AZURE_CLI_VERSION=2.88.0-1~bookworm

# =======================
# Node.js (GPG)
# -----------------------
# : apt search nodejs$
# =======================

INSTALL_NODE_JS=true
NODE_JS_VERSION=22.23.1-1nodesource1
NODE_JS_MAJOR=22

# =======================
# Extras (configs)
# =======================

LIQUIDPROMPT_THEME=powerline

# =======================
# Gomplate 
# =======================

INSTALL_GOMPLATE=true
GOMPLATE_VERSION=v5.2.0
GOMPLATE_SHA256=a235564c12f12e755c06e3ab2af414ab1e3f5b1f142eb82ea2d8086145670a81

# =======================
# ACT (BIN)
# =======================

INSTALL_ACT=true
ACT_VERSION=v0.2.89
ACT_SHA256=0191d6f1f3b716b5c55820032605d05fc3c1cdbf581ebeff655019e5dd1524c0

# =======================
# Extras (packages)
# -----------------------
# : node package
# : cargo packages
# : python packages
# =======================

RUST_TOOLCHAIN=1.98.1
CARGO_TREE_SITTER_CLI=0.26.11
NPM_NEOVIM=5.4.0
NPM_OPENCODE_AI=1.18.13
NPM_CODEX=0.153.4
PIPX_UV=0.12.1

# =======================
# PROXY
# =======================

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# =======================
# GITHUB
# =======================

GITHUB_TOKEN=
